# Paste these into the Secrets box on Streamlit Community Cloud (Advanced settings when you deploy; afterwards App settings > Secrets).
# Easier: fill in the Streamlit block at the bottom of your .env and run `make streamlit-secrets`, which prints this whole box ready to paste.
# NEVER commit a real secrets.toml: it is git-ignored. Write every value as a string.

# --- The AI assistant (Amazon Bedrock's OpenAI-compatible endpoint)
OPENAI_API_KEY = "paste-your-bedrock-api-key"
OPENAI_BASE_URL = "https://bedrock-runtime.us-east-1.amazonaws.com/openai/v1"

# --- How the app is shared
NSW_VIEW_ONLY = "1"                                   # reviewers cannot switch live generation on
# NSW_ACCESS_CODE = "choose-a-long-random-code"       # OPTIONAL: add it and everyone must enter it. Leave it out and the app opens without a prompt
NSW_TOKEN_BUDGET_DAY = "1000000"                      # daily AI usage cap

# --- Where the data comes from: a PRIVATE Hugging Face dataset, and a READ-ONLY token for that one dataset
NSW_DB_REPO = "your-hf-name/nsw-demo-db"
HF_TOKEN = "hf_paste-the-read-only-token"

# --- Only for one boot after you publish new data: loads it over the older copy. Remove it again afterwards.
# NSW_DB_FORCE = "1"
