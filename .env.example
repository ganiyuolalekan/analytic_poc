# Copy to .env and fill in. NEVER commit .env.
# OpenAI-compatible endpoint (AWS Bedrock API key works as a bearer token).
OPENAI_API_KEY=replace-me
# Optional. If the model you want is not served on this host, the probe falls back to
# https://bedrock-runtime.<region>.amazonaws.com/openai/v1 (derived from the region).
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
# AWS_REGION=us-east-1
# Optional overrides (first match wins; probe is authoritative):
# LLM_BASE_URL=
# LLM_MODEL=us.openai.gpt-5.5
# LLM_MODEL_DATA=
# LLM_MODEL_CHAT=
# NSW_OFFLINE=1        # force the deterministic fallback for every LLM role
